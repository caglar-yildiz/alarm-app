<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer: the same files for cloud backup and for moving to a new phone. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="." />
        <include domain="device_sharedpref" path="." />
        <exclude domain="device_sharedpref" path="premium_preview.xml" />
        <exclude domain="device_sharedpref" path="ring_record.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
        <include domain="device_sharedpref" path="." />
        <exclude domain="device_sharedpref" path="premium_preview.xml" />
        <exclude domain="device_sharedpref" path="ring_record.xml" />
    </device-transfer>
</data-extraction-rules>
